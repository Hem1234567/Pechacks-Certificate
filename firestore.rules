rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /certificates/{certificateId} {
      // Authenticated users (Admins) have full access to manage certificates
      allow read, write: if request.auth != null;
      
      // Public users can read certificates for verification
      allow read: if request.auth == null;
      
      // Public users can only update the scan_count (strictly incrementing by 1)
      allow update: if request.auth == null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['scan_count'])
                    && (
                      (!('scan_count' in resource.data) && request.resource.data.scan_count == 1) ||
                      (request.resource.data.scan_count == resource.data.scan_count + 1)
                    );
    }

    // ── Certificate Templates (new) ──────────────────────────────────────────
    match /certificate_templates/{templateId} {
      // Admins can create, update, delete and read templates
      allow read, write, delete: if request.auth != null;

      // Public users can READ templates so the certificate page can render
      // the correct layout (name, QR style, field positions) without logging in
      allow read: if request.auth == null;
    }
  }
}
